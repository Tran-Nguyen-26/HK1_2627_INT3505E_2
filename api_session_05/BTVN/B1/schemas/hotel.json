{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hotel",
  "type": "object",
  "required": ["id", "name", "city", "rating"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^hotel_[a-z0-9]+$",
      "description": "Mã định danh khách sạn, bắt đầu bằng tiền tố hotel_"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Tên khách sạn"
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "description": "Thành phố tọa lạc"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Đánh giá trung bình từ 0 đến 5 sao"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Thời điểm khởi tạo bản ghi (ISO 8601)"
    }
  },
  "additionalProperties": false
}